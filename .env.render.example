# Render production environment for Avark Laravel
# Copy these entries into Render: Web Service > Environment > Add from .env

APP_NAME="Avark Pvt. Ltd."
APP_ENV=production
APP_KEY=base64:Qr7z4JCgGFw8GIRny25/WQ5sorPaJ+0k2uodsCcgB3s=
APP_DEBUG=false
APP_URL=https://avarknewwebsite.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# The serversideup/php NGINX image listens on 8080.
PORT=8080
NGINX_WEBROOT=/var/www/html/public
HEALTHCHECK_PATH=/up
PHP_OPCACHE_ENABLE=1
PHP_DATE_TIMEZONE=Asia/Kolkata

# Send Laravel logs to the Render log stream.
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Create a Render PostgreSQL database in the same region and paste its
# INTERNAL database URL here. This application reads DB_URL.
DB_CONNECTION=pgsql
DB_URL=postgresql://USER:PASSWORD@INTERNAL_HOST:5432/DATABASE
DB_SSLMODE=prefer

# These use the sessions/cache tables already included in the migrations.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database

# No worker service is currently required by this website.
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=public
WEB_ROOT_PATH=/var/www/html/public

# The current contact page does not send server-side email. Keep this as log
# until SMTP is implemented, then replace it with your provider's credentials.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=support@avark.in
MAIL_FROM_NAME="Avark Pvt. Ltd."

VITE_APP_NAME="Avark Pvt. Ltd."

# Optional SMTP example:
# MAIL_MAILER=smtp
# MAIL_SCHEME=tls
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=your-smtp-username
# MAIL_PASSWORD=your-smtp-password
# MAIL_FROM_ADDRESS=support@avark.in
# MAIL_FROM_NAME="Avark Pvt. Ltd."
